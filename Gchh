local function UpdateCameraNoclip()
    if Settings.CamNoclip then
        LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
    else
        LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
    end
end

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        MyHPBar.Size = UDim2.new(hp, 0, 1, 0)
        MyHPText.Text = "HP: "..math.floor(hum.Health).." / "..math.floor(hum.MaxHealth)
        MyHPBar.BackgroundColor3 = (hum.Health <= 30) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 100)
    end
    
    UpdateCameraNoclip()
    
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOV_W.Visible = Settings.ShowFOV and Settings.Aimbot
    FOV_W.Radius = Settings.FOVSize
    FOV_W.Position = center
    FOV_B.Visible = Settings.ShowFOV and Settings.Aimbot
    FOV_B.Radius = Settings.FOVSize - 1.2
    FOV_B.Position = center
    
    if Settings.Aimbot then
        currentTarget = GetClosestTarget()
        
        if currentTarget and currentTarget.Character and targetPart and targetPart.Parent and not Settings.Whitelist[currentTarget.UserId] then
            if not IsAdmin(currentTarget) then
                local screen, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    tracerLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    tracerLine.To = Vector2.new(screen.X, screen.Y)
                    tracerLine.Visible = true
                else
                    tracerLine.Visible = false
                end
            else
                tracerLine.Visible = false
            end
        else
            tracerLine.Visible = false
        end
    else
        tracerLine.Visible = false
        currentTarget = nil
        targetPart = nil
    end
end)


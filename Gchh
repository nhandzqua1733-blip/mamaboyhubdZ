local function GetLegPart(character)
    if not character then return nil end
    local legNames = {"LeftLeg", "RightLeg", "LeftFoot", "RightFoot"}
    for _, legName in ipairs(legNames) do
        local leg = character:FindFirstChild(legName)
        if leg and leg:IsA("BasePart") then return leg end
    end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")
end

local function GetRandomBodyPart(character)
    if not character then return nil end
    local allParts = {}
    local possibleParts = {"Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}
    for _, partName in ipairs(possibleParts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then table.insert(allParts, part) end
    end
    if #allParts > 0 then return allParts[math.random(1, #allParts)] end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")
end

local function GetTargetPart(character)
    if not character then return nil end
    if Settings.AimType == "Leg" then
        return GetLegPart(character)
    else
        return GetRandomBodyPart(character)
    end
end

local function GetClosestTarget()
    local closest = nil
    local shortest = math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Settings.Whitelist[player.UserId] then continue end
        if IsAdmin(player) then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        local part = GetTargetPart(character)
        if not part then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        
        if Settings.ShowFOV then
            if dist < Settings.FOVSize and dist < shortest then
                shortest = dist
                closest = player
                targetPart = part
            end
        else
            if dist < shortest then
                shortest = dist
                closest = player
                targetPart = part
            end
        end
    end
    
    return closest
end

local oldNameCall
oldNameCall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if Settings.Aimbot and method == "Raycast" and self == Workspace and not checkcaller() then
        if currentTarget and currentTarget.Character and targetPart and targetPart.Parent and not Settings.Whitelist[currentTarget.UserId] then
            if IsAdmin(currentTarget) then
                return oldNameCall(self, unpack(args))
            end
            
            local origin = args[1]
            local actualDistance = (targetPart.Position - origin).Magnitude
            local direction = (targetPart.Position - origin).Unit * actualDistance
            
            args[2] = direction
            return oldNameCall(self, unpack(args))
        end
    end
    
    return oldNameCall(self, ...)
end))

local function FindSendRemote()
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:lower():find("send") or v.Name:lower():find("shoot") or v.Name:lower():find("fire") or v.Name:lower():find("bullet")) then
            return v
        end
    end
    return nil
end

local send = FindSendRemote()
local oldFire

if send then
    oldFire = hookfunction(send.FireServer, function(self, ...)
        local args = {...}

        if Settings.Aimbot and currentTarget and currentTarget.Character and targetPart and targetPart.Parent and not Settings.Whitelist[currentTarget.UserId] then
            if IsAdmin(currentTarget) then
                return oldFire(self, unpack(args))
            end
            
            local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local origin = myHead or myRoot
            
            if origin then
                for i, v in pairs(args) do
                    if typeof(v) == "table" then
                        for j, bullet in pairs(v) do
                            if typeof(bullet) == "table" then
                                if bullet.Instance then bullet.Instance = targetPart end
                                if bullet.Position then bullet.Position = targetPart.Position end
                                if bullet.Velocity then bullet.Velocity = Vector3.zero end
                                if bullet.Direction then bullet.Direction = (targetPart.Position - origin.Position).Unit end
                            end
                        end
                    end
                end
                
                for i, v in pairs(args) do
                    if typeof(v) == "CFrame" then
                        args[i] = CFrame.lookAt(origin.Position, targetPart.Position)
                    end
                end
                
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" and i > 1 then
                        args[i] = targetPart.Position
                    end
                end
            end
        end

        return oldFire(self, unpack(args))
    end)
end

local function addESP(p)
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(0, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    local name = Drawing.new("Text")
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.new(0, 0, 0)
    name.Size = 13
    local hpTxt = Drawing.new("Text")
    hpTxt.Center = true
    hpTxt.Outline = true
    hpTxt.OutlineColor = Color3.new(0, 0, 0)
    hpTxt.Size = 12
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if p.Character and p ~= LocalPlayer and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 and Settings.MasterESP then
            highlight.Parent = p.Character
            highlight.Enabled = true
            local head = p.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    name.Visible = true
                    if IsAdmin(p) then
                        name.Text = p.Name .. " [ADMIN]"
                        name.Color = Color3.fromRGB(255, 100, 100)
                    else
                        name.Text = p.Name
                        name.Color = Color3.new(1, 1, 1)
                    end
                    name.Position = Vector2.new(pos.X, pos.Y - 30)
                    hpTxt.Visible = true
                    hpTxt.Text = math.floor(p.Character.Humanoid.Health).." HP"
                    hpTxt.Color = Color3.fromRGB(100, 255, 100)
                    hpTxt.Position = Vector2.new(pos.X, pos.Y - 15)
                else
                    name.Visible = false
                    hpTxt.Visible = false
                end
            end
        else
            highlight.Enabled = false
            highlight.Parent = nil
            name.Visible = false
            hpTxt.Visible = false
        end
        if not p.Parent then
            highlight:Destroy()
            name:Remove()
            hpTxt:Remove()
            conn:Disconnect()
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then addESP(p) end
end
Players.PlayerAdded:Connect(addESP)


local function UpdateWhitelist()
    for _, v in pairs(WLFrame:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not IsAdmin(p) then
            local b = Instance.new("TextButton", WLFrame)
            b.Size = UDim2.new(1, -10, 0, 28)
            b.Position = UDim2.new(0, 5, 0, count * 30)
            b.Text = p.Name
            b.BackgroundColor3 = Settings.Whitelist[p.UserId] and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(35, 35, 35)
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.SourceSans
            b.TextSize = 12
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function()
                Settings.Whitelist[p.UserId] = not Settings.Whitelist[p.UserId]
                b.BackgroundColor3 = Settings.Whitelist[p.UserId] and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(35, 35, 35)
            end)
            count = count + 1
        end
    end
    WLFrame.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 10)
end

WLBtn.MouseButton1Click:Connect(function()
    WLFrame.Visible = not WLFrame.Visible
    if WLFrame.Visible then
        UpdateWhitelist()
    end
end)

